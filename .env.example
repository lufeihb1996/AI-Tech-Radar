# ============================================================================
# AI Tech Radar - Environment Configuration Template
# Copy this file to `.env` (or configure directly via the Web UI Settings modal)
# ============================================================================

HOST=127.0.0.1
PORT=8096

# 1. Official TypeSafe Jev API Key (https://console.typesafe.ai)
# Used for 4-dimensional AI signal scoring & hype/noise filtering
TYPESAFE_API_KEY=

# 2. X (Twitter) Web Session Cookies (x.com -> F12 -> Application -> Cookies)
# Required only if you enable the X (For You / Following / Cross-Search) source
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# 3. OpenRouter API Key (https://openrouter.ai/keys)
# Used ONLY when you manually click "Translate" on a card or page (default: DeepSeek V4 Flash)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
